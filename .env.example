# Groq (free tier), called via its OpenAI-compatible endpoint
GROQ_API_KEY=

# Langfuse tracing (free tier at cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Alpaca — Trading API, paper account
# Paper and live keys must use distinct names (never reuse a live key here).
# See docs/SCRUM-9 findings: paper-api.alpaca.markets vs api.alpaca.markets
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# API key required by clients of the FastAPI /chat endpoint (X-API-Key
# header). This endpoint can place real (paper) trades — never deploy
# without this set to a real secret.
COMPASS_API_KEY=
